\f0\fs24 \cf0 CALIFICACIONES (Calificaciones.psc)\
\
Algoritmo Calificaciones\
	Definir i, aprobados Como Entero\
	Definir nota, suma, promedio, maximo, minimo Como Real\
	Definir alguienPerdio Como Logico\
	suma <- 0\
	aprobados <- 0\
	maximo <- 0\
	minimo <- 5\
	alguienPerdio <- Falso\
	Para i <- 1 Hasta 5 Con Paso 1 Hacer\
		Escribir "Escribe la nota del estudiante ", i, ":"\
		Leer nota\
		suma <- suma + nota\
		Si nota >= 3 Entonces\
			aprobados <- aprobados + 1\
		SiNo\
			alguienPerdio <- Verdadero\
		FinSi\
		Si nota > maximo Entonces\
			maximo <- nota\
		FinSi\
		Si nota < minimo Entonces\
			minimo <- nota\
		FinSi\
	FinPara\
	promedio <- suma / 5\
	Escribir "El promedio es: ", promedio\
	Escribir "Aprobaron: ", aprobados\
	Escribir "Nota m\'e1s alta: ", maximo\
	Escribir "Nota m\'e1s baja: ", minimo\
	Si alguienPerdio Entonces\
		Escribir "Hubo al menos un estudiante que perdi\'f3"\
	SiNo\
		Escribir "Nadie perdi\'f3"\
	FinSi\
FinAlgoritmo\
\
