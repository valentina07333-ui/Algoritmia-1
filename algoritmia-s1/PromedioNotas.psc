Algoritmo PromedioNotas
	Definir nota1, nota2, nota3, promedio Como Real
	Escribir "Escribe la primera nota (de 0 a 5):"
	Leer nota1
	Escribir "Escribe la segunda nota (de 0 a 5):"
	Leer nota2
	Escribir "Escribe la tercera nota (de 0 a 5):"
	Leer nota3
	promedio <- (nota1 + nota2 + nota3) / 3
	Escribir "El promedio de las notas es: ", promedio
FinAlgoritmo