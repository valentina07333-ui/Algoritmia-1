\f0\fs24 \cf0 PARQUEADERO\
\
Reglas del administrador\
1. Carro: $4.000 por hora o fracci\'f3n. Moto: $2.000.\
2. Los primeros 15 minutos son gratis.\
3. El cobro m\'e1ximo del d\'eda es $30.000.\
4. Con factura del centro comercial paga la mitad (despu\'e9s del m\'e1ximo).\
5. Tipo que no sea carro ni moto, o minutos negativos: error.\
\
\
C\'d3DIGO (Parqueadero.psc)\
\
Algoritmo Parqueadero\
	Definir tipo, factura Como Caracter\
	Definir minutos, horas, tarifa Como Entero\
	Definir valor Como Real\
	Escribir "\'bfQu\'e9 tipo de veh\'edculo es? (carro/moto)"\
	Leer tipo\
	Escribir "\'bfCu\'e1ntos minutos estuvo?"\
	Leer minutos\
	Escribir "\'bfTiene factura del centro comercial? (S/N)"\
	Leer factura\
	tipo <- Minusculas(tipo)\
	factura <- Mayusculas(factura)\
	Si tipo <> "carro" Y tipo <> "moto" Entonces\
		Escribir "Tipo no v\'e1lido"\
	SiNo\
		Si minutos < 0 Entonces\
			Escribir "Minutos negativos"\
		SiNo\
			Si minutos <= 15 Entonces\
				valor <- 0\
			SiNo\
				Si tipo = "carro" Entonces\
					tarifa <- 4000\
				SiNo\
					tarifa <- 2000\
				FinSi\
				horas <- trunc(minutos / 60)\
				Si minutos MOD 60 > 0 Entonces\
					horas <- horas + 1\
				FinSi\
				valor <- horas * tarifa\
				Si valor > 30000 Entonces\
					valor <- 30000\
				FinSi\
				Si factura = "S" Entonces\
					valor <- valor / 2\
				FinSi\
			FinSi\
			Escribir "El valor a pagar es: $", valor\
		FinSi\
	FinSi\
FinAlgoritmo\
\
